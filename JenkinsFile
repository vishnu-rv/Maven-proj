pipeline {
    agent any

    environment {
        DOCKER_CRED = credentials('b00b8acc-1de9-4bdb-8f18-e7cc2224f523') // Docker credentials
        GIT_CRED = credentials('b5418ac8-431e-43db-85f5-ea11f7a89d74')     // Git credentials
        SONAR_CRED = credentials('05a2246e-f3b7-49d4-90e8-3013c427c817')   // SonarQube token
        KUBECONFIG_CRED = credentials('8a6566ad-3999-402a-ae64-456e0f71540d') // Kubeconfig file
        DOCKER_IMAGE = "vishnu2117/maven-proj:v1"
        ARGOCD_SERVER = "https://116.204.173.18" // ArgoCD server URL
        ARGOCD_USER = "admin"                    // ArgoCD username
        ARGOCD_PASS = "LhgvkGBWWTbP6COt"         // ArgoCD password
    }

    stages {
        stage('Checkout Code') {
            steps {
                git credentialsId: "${GIT_CRED}", url: 'https://github.com/vishnu-rv/Maven-proj.git'
            }
        }

        stage('Build Application') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    sh 'mvn sonar:sonar -Dsonar.login=$SONAR_CRED'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    sh """
                    docker login -u $DOCKER_CRED_USR -p $DOCKER_CRED_PSW
                    docker build -t $DOCKER_IMAGE .
                    docker push $DOCKER_IMAGE
                    """
                }
            }
        }

        stage('Update ArgoCD Deployment') {
            steps {
                script {
                    withCredentials([string(credentialsId: 'b00b8acc-1de9-4bdb-8f18-e7cc2224f523', variable: 'ARGOCD_PASS')]) {
                        sh """
                        argocd login $ARGOCD_SERVER --username $ARGOCD_USER --password $ARGOCD_PASS --insecure
                        argocd app sync my-application-name
                        """
                    }
                }
            }
        }
    }

    post {
        always {
            echo 'Pipeline Completed'
        }
    }
}


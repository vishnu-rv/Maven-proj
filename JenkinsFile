pipeline {
    agent any
    environment {
        DOCKER_CRED = credentials('b00b8acc-1de9-4bdb-8f18-e7cc2224f523')  // Docker credentials
        GIT_CRED = credentials('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')      // Git credentials
        SONAR_CRED = credentials('05a2246e-f3b7-49d4-90e8-3013c427c817')    // SonarQube token
        KUBECONFIG_CRED = credentials('8a6566ad-3999-402a-ae64-456e0f71540d') // Kubeconfig file
        DOCKER_IMAGE = "vishnu2117/maven-proj:v1"
        ARGOCD_SERVER = "https://116.204.173.18" // ArgoCD server URL
        ARGOCD_USER = "admin"                     // ArgoCD username
        ARGOCD_PASS = "LhgvkGBWWTbP6COt"          // ArgoCD password
    }
    stages {
        stage('Build Docker Image') {
            steps {
                script {
                    echo 'Building Docker image...'
                    // Build the Docker image
                    sh 'docker build -t $DOCKER_IMAGE .'
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                script {
                    echo 'Pushing Docker image to Docker registry...'
                    // Push the Docker image to your registry
                    withCredentials([usernamePassword(credentialsId: 'b00b8acc-1de9-4bdb-8f18-e7cc2224f523', passwordVariable: 'DOCKER_PASS', usernameVariable: 'DOCKER_USER')]) {
                        sh 'docker login -u $DOCKER_USER -p $DOCKER_PASS'
                        sh 'docker push $DOCKER_IMAGE'
                    }
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                script {
                    echo 'Deploying to Kubernetes...'
                    // Apply the Kubernetes deployment and service files
                    withCredentials([file(credentialsId: '8a6566ad-3999-402a-ae64-456e0f71540d', variable: 'KUBECONFIG')]) {
                        sh 'kubectl apply -f k8s/deployment.yaml'  // Replace with your actual deployment.yaml file
                        sh 'kubectl apply -f k8s/service.yaml'      // Replace with your actual service.yaml file
                    }
                }
            }
        }

        stage('Update ArgoCD Deployment') {
            steps {
                script {
                    echo 'Updating ArgoCD deployment...'
                    // Add your ArgoCD deployment update steps
                    // Login to ArgoCD
                    sh """
                    argocd login $ARGOCD_SERVER --username $ARGOCD_USER --password $ARGOCD_PASS --insecure
                    argocd app sync <your-app-name>  // Replace with your ArgoCD app name
                    """
                }
            }
        }
    }
    post {
        always {
            echo 'Pipeline Completed'
        }
        success {
            echo 'Build and deployment successful!'
        }
        failure {
            echo 'Build or deployment failed.'
        }
    }
}
